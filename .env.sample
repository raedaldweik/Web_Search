# ---------------------------------------------------------------------------
# News & Intelligence MCP server
# ---------------------------------------------------------------------------

# Required. Tavily API key — get a free one at https://tavily.com
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Domain controls (the "approved domains" feature)
# ---------------------------------------------------------------------------
# APPROVED_DOMAINS: comma/newline-separated allow-list. When set, ALL searches
# are restricted to these domains and (unless DOMAIN_ENFORCE=false) reading an
# article from any other domain is refused. Sub-domains match automatically, so
# "gov.ae" also allows "traffic.gov.ae". Leave empty to search the open web.
# Example: APPROVED_DOMAINS=gov.ae,thenationalnews.com,reuters.com
APPROVED_DOMAINS=

# BLOCKED_DOMAINS: comma/newline-separated deny-list, always excluded.
BLOCKED_DOMAINS=

# When true (default) reading an article outside the approved list is refused.
# Set to false to allow reading any URL while still filtering search results.
DOMAIN_ENFORCE=true

# ---------------------------------------------------------------------------
# Search defaults (callers can override per tool call)
# ---------------------------------------------------------------------------
MAX_RESULTS=8
# basic (fast/cheap) or advanced (deeper)
DEFAULT_SEARCH_DEPTH=basic
# Default recency window for news: day | week | month | year
DEFAULT_TIME_RANGE=week
# Cap characters of fetched article text (0 disables)
MAX_CONTENT_CHARS=8000
REQUEST_TIMEOUT=30

# ---------------------------------------------------------------------------
# Server / transport
# ---------------------------------------------------------------------------
HOST_PORT=8140
# Protect the HTTP endpoint with a static key (sent as X-API-Key or Bearer).
MCP_API_KEY=
# "http" (streamable HTTP, endpoint /mcp, default) or "sse" (endpoint /sse)
MCP_TRANSPORT=http
# Container mode: http-direct (default, for RAM hosting) or stdio
MCP_MODE=http-direct

# Set to false to disable TLS verification (e.g. self-signed corporate proxy)
SSL_VERIFY=true

# Optional override of the Tavily base URL (rarely needed)
# TAVILY_BASE_URL=https://api.tavily.com
